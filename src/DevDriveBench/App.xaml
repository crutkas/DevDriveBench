<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DevDriveBench.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Stage palette. Two data colors only: slate = system drive, azure = Dev Drive. Everything
                else is a neutral ramp so the eye goes to data. The app runs dark for projection; Light
                mirrors Dark on purpose, and High Contrast maps to system colors.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StageBackgroundBrush" Color="#0A0D12" />
                    <SolidColorBrush x:Key="StageHairlineBrush" Color="#1C232D" />
                    <SolidColorBrush x:Key="StageTrackBrush" Color="#11161D" />
                    <SolidColorBrush x:Key="StageTextPrimaryBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="StageTextSecondaryBrush" Color="#9AA3B2" />
                    <SolidColorBrush x:Key="StageTextTertiaryBrush" Color="#5C6575" />
                    <SolidColorBrush x:Key="SystemDriveBrush" Color="#8C97A7" />
                    <SolidColorBrush x:Key="SystemDriveLiveBrush" Color="#3A4350" />
                    <SolidColorBrush x:Key="DevDriveBrush" Color="#38BDFF" />
                    <SolidColorBrush x:Key="DevDriveLiveBrush" Color="#134461" />
                    <SolidColorBrush x:Key="PrepareBrush" Color="#262D37" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StageBackgroundBrush" Color="#0A0D12" />
                    <SolidColorBrush x:Key="StageHairlineBrush" Color="#1C232D" />
                    <SolidColorBrush x:Key="StageTrackBrush" Color="#11161D" />
                    <SolidColorBrush x:Key="StageTextPrimaryBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="StageTextSecondaryBrush" Color="#9AA3B2" />
                    <SolidColorBrush x:Key="StageTextTertiaryBrush" Color="#5C6575" />
                    <SolidColorBrush x:Key="SystemDriveBrush" Color="#8C97A7" />
                    <SolidColorBrush x:Key="SystemDriveLiveBrush" Color="#3A4350" />
                    <SolidColorBrush x:Key="DevDriveBrush" Color="#38BDFF" />
                    <SolidColorBrush x:Key="DevDriveLiveBrush" Color="#134461" />
                    <SolidColorBrush x:Key="PrepareBrush" Color="#262D37" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StageHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StageTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StageTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StageTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StageTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="SystemDriveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SystemDriveLiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="DevDriveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DevDriveLiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PrepareBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="StageNumberFont">Segoe UI Variable Display</FontFamily>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource StageTextTertiaryBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource StageTextTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
