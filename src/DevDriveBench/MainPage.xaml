<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveBench.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveBench.Controls"
    xmlns:model="using:DevDriveBench.Engine.Model"
    xmlns:vm="using:DevDriveBench.ViewModels"
    Background="{ThemeResource StageBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRunAccelerator" />
        <KeyboardAccelerator Key="F6" Invoked="OnPrepareAccelerator" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnStopAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="44,6,44,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: the two drives (doubles as the color legend) and the few controls  -->
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Rectangle Width="4" Height="30" Fill="{ThemeResource SystemDriveBrush}" />
                <TextBlock
                    x:Name="SystemLetterText"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemDriveBrush}"
                    Text="C:" />
                <TextBlock
                    x:Name="SystemCaptionText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource StageTextSecondaryBrush}" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource StageTextTertiaryBrush}"
                Text="vs" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Rectangle Width="4" Height="30" Fill="{ThemeResource DevDriveBrush}" />
                <TextBlock
                    x:Name="DevLetterText"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource DevDriveBrush}"
                    Text="—" />
                <TextBlock
                    x:Name="DevCaptionText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource StageTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <SelectorBar x:Name="ModeBar" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" SelectionChanged="OnModeChanged">
                    <SelectorBarItem x:Name="LiveItem" IsSelected="True" Text="Live" />
                    <SelectorBarItem x:Name="ReplayItem" Text="Replay" />
                </SelectorBar>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsLiveMode, Mode=OneWay}">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource StageTextSecondaryBrush}" Text="Packages" />
                    <ToggleSwitch
                        x:Name="PackagesToggle"
                        MinWidth="0"
                        Margin="0,0,20,0"
                        AutomationProperties.AutomationId="PackagesToggle"
                        AutomationProperties.Name="Packages on the optimal drive"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.PackagesOnOptimalDrive, Mode=TwoWay}"
                        OffContent="C drive"
                        OnContent="Optimal drive"
                        ToolTipService.ToolTip="Optimal drive: each run's npm_config_cache, NUGET_PACKAGES and CARGO_HOME are on its own drive. C drive: the Dev Drive run reads them from C:. Set for the benchmark's own processes only; your environment variables are not changed." />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource StageTextSecondaryBrush}" Text="Runs" />
                    <NumberBox
                        x:Name="RunsBox"
                        Width="104"
                        AutomationProperties.Name="Runs per drive"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Maximum="25"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ToolTipService.ToolTip="Runs per drive per test. With 2 or more, run 1 is a warm-up and the median of the rest is reported."
                        Value="{x:Bind ViewModel.Iterations, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsReplayMode, Mode=OneWay}">
                    <ComboBox
                        x:Name="RecordingBox"
                        Width="420"
                        AutomationProperties.Name="Recording to replay"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneTime}"
                        SelectionChanged="OnRecordingChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordingItem">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox
                        Width="78"
                        AutomationProperties.Name="Replay speed"
                        ItemsSource="{x:Bind ViewModel.ReplaySpeeds, Mode=OneTime}"
                        SelectedIndex="{x:Bind ViewModel.ReplaySpeedIndex, Mode=TwoWay}" />
                </StackPanel>

                <Button
                    x:Name="PlanButton"
                    AutomationProperties.Name="Tests and options"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    ToolTipService.ToolTip="Tests and options">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="380" Spacing="10">
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="TESTS" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Tests, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TestToggle">
                                            <Grid Margin="0,0,0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsAvailable, Mode=OneWay}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource StageTextTertiaryBrush}"
                                                            Text="{x:Bind Note, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind InstallButtonName, Mode=OneTime}"
                                                    Command="{x:Bind InstallCommand, Mode=OneTime}"
                                                    Content="Install"
                                                    ToolTipService.ToolTip="{x:Bind InstallTooltip, Mode=OneTime}"
                                                    Visibility="{x:Bind CanInstall, Mode=OneWay}" />
                                                <ProgressRing
                                                    Grid.Column="1"
                                                    Width="20"
                                                    Height="20"
                                                    IsActive="{x:Bind IsInstalling, Mode=OneWay}"
                                                    Visibility="{x:Bind IsInstalling, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="28,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource StageTextSecondaryBrush}"
                                                    Text="{x:Bind InstallStatus, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind HasInstallStatus, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,6,0,0" Style="{StaticResource SectionLabelStyle}" Text="GIT CLONE FIXTURE" />
                                <RadioButtons x:Name="ProfileButtons" SelectionChanged="OnProfileChanged">
                                    <x:String>15,000 files · Thorough</x:String>
                                    <x:String>1,200 files · Quick</x:String>
                                </RadioButtons>

                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Text="DEV DRIVE" />
                                <ComboBox
                                    x:Name="DevDriveBox"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Dev Drive"
                                    ItemsSource="{x:Bind ViewModel.DevDriveChoices, Mode=OneTime}"
                                    SelectionChanged="OnDevDriveChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:DriveDescriptor">
                                            <TextBlock>
                                                <Run Text="{x:Bind Letter, Mode=OneTime}" />
                                                <Run Text="{x:Bind FileSystem, Mode=OneTime}" />
                                                <Run Text="{x:Bind Label, Mode=OneTime}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <HyperlinkButton
                                    Margin="-12,6,0,0"
                                    Command="{x:Bind ViewModel.ClearPreparedCommand, Mode=OneTime}"
                                    Content="Delete prepared fixtures" />
                                <HyperlinkButton
                                    Margin="-12,-6,0,0"
                                    Command="{x:Bind ViewModel.OpenRunsFolderCommand, Mode=OneTime}"
                                    Content="Open runs folder (JSON + CSV)" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Grid VerticalAlignment="Center">
                    <Button
                        x:Name="PrepareButton"
                        MinWidth="112"
                        AutomationProperties.Name="Prepare"
                        Command="{x:Bind ViewModel.PrepareCommand, Mode=OneTime}"
                        IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}"
                        ToolTipService.ToolTip="Prepare every test's fixture now (clones, package downloads) so Run goes straight to measuring"
                        Visibility="{x:Bind ViewModel.ShowPrepareButton, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="Prepare" />
                        </StackPanel>
                    </Button>
                    <StackPanel
                        x:Name="ReadyChip"
                        MinWidth="112"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ReadyChip"
                        AutomationProperties.Name="Prepared, ready to run"
                        Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="Fixtures prepared: Run goes straight to measuring"
                        Visibility="{x:Bind ViewModel.IsPrepared, Mode=OneWay}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource DevDriveBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DevDriveBrush}"
                            Text="Ready" />
                    </StackPanel>
                </Grid>

                <Button
                    x:Name="RunButton"
                    MinWidth="112"
                    AutomationProperties.Name="{x:Bind ViewModel.RunLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RunOrStopCommand, Mode=OneTime}"
                    IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.RunGlyph, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.RunLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Hero: the one number that matters, and what the machine is doing right now  -->
        <Grid Grid.Row="1" Margin="0,26,0,0" ColumnSpacing="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock
                    x:Name="HeadlineText"
                    Margin="-6,0,0,0"
                    AutomationProperties.AutomationId="Headline"
                    FontFamily="{StaticResource StageNumberFont}"
                    FontSize="128"
                    FontWeight="SemiLight"
                    Foreground="{ThemeResource StageTextTertiaryBrush}"
                    LineHeight="128"
                    LineStackingStrategy="BlockLineHeight"
                    MinHeight="128"
                    Text="" />
                <TextBlock
                    x:Name="HeadlineCaption"
                    Margin="0,10,0,0"
                    FontSize="22"
                    Foreground="{ThemeResource StageTextPrimaryBrush}"
                    Text="faster dev workloads on the Dev Drive" />
                <TextBlock
                    x:Name="HeadlineDetail"
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{ThemeResource StageTextTertiaryBrush}" />
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Bottom" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="112" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DISK I/O ON THE DRIVE UNDER TEST" />
                <controls:Sparkline x:Name="IoSpark" Grid.Row="1" />
                <TextBlock
                    x:Name="IoValueText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Bottom"
                    FontFamily="{StaticResource StageNumberFont}"
                    FontSize="22"
                    Foreground="{ThemeResource StageTextPrimaryBrush}" />

                <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource SectionLabelStyle}" Text="CPU" />
                <controls:Sparkline x:Name="CpuSpark" Grid.Row="3" />
                <TextBlock
                    x:Name="CpuValueText"
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Bottom"
                    FontFamily="{StaticResource StageNumberFont}"
                    FontSize="16"
                    Foreground="{ThemeResource StageTextSecondaryBrush}" />

                <Grid Grid.Row="4">
                    <TextBlock Style="{StaticResource SectionHintStyle}" Text="−60 s" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SectionHintStyle}" Text="now" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Now: what is running, and the whole run as one strip  -->
        <Grid Grid.Row="2" Margin="0,30,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse
                    x:Name="NowDot"
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource StageTextTertiaryBrush}" />
                <TextBlock
                    x:Name="NowText"
                    AutomationProperties.AutomationId="NowText"
                    FontSize="18"
                    Foreground="{ThemeResource StageTextPrimaryBrush}" />
            </StackPanel>
            <TextBlock
                x:Name="ElapsedText"
                Grid.Column="1"
                AutomationProperties.AutomationId="Elapsed"
                FontFamily="{StaticResource StageNumberFont}"
                FontSize="18"
                Foreground="{ThemeResource StageTextSecondaryBrush}" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{ThemeResource StageHairlineBrush}" />
            <controls:TimelineRibbon x:Name="Ribbon" Height="6" />
        </Grid>

        <!--  Results: small multiples, one row per test  -->
        <ScrollViewer Grid.Row="4" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="WorkloadHeader" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DEV WORKLOADS" />
                        <TextBlock Style="{StaticResource SectionHintStyle}" Text="wall-clock seconds · shorter is faster" />
                    </StackPanel>
                    <TextBlock
                        x:Name="AdvantageHeader"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="DEV DRIVE ADVANTAGE" />
                </Grid>
                <StackPanel x:Name="WorkloadRows" />

            </StackPanel>
        </ScrollViewer>

        <!--  Footer: provenance, in small type  -->
        <Grid Grid.Row="5" Margin="0,14,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                AutomationProperties.AutomationId="Footer"
                Style="{StaticResource SectionHintStyle}"
                Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="MachineText"
                Grid.Column="1"
                Style="{StaticResource SectionHintStyle}" />
        </Grid>
    </Grid>
</Page>
