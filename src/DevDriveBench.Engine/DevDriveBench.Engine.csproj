<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-agnostic benchmark engine: synthetic disk I/O + real developer workloads, a timestamped event
    stream (shared by Live and Replay), recordings (JSON + CSV), and the aggregation math.
    No WinUI dependency, so it is unit-testable and usable from the headless CLI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DevDriveBench.Engine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevDriveBench.Engine.Tests" />
  </ItemGroup>

</Project>
